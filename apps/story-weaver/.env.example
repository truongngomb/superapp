# ============================================
# StoryWeaver Frontend Configuration
# ============================================
# Copy this file to .env and adjust values as needed

# --------------------------------------------
# API Configuration
# --------------------------------------------
# Base URL for the StoryWeaver API
# In development: uses relative path (proxied by Vite)
# In production: set to your API server URL
VITE_API_BASE_URL=/api/story-weaver

# Legacy (backward compatibility)
VITE_API_URL=http://localhost:3001

# --------------------------------------------
# Development Server
# --------------------------------------------
# Port for the Vite development server
VITE_PORT=3102

# Enable debug mode (shows additional logging)
VITE_ENABLE_DEBUG=false

# --------------------------------------------
# Pagination (Optional)
# --------------------------------------------
# Default items per page
VITE_DEFAULT_PAGE_SIZE=20

# Maximum items per page
VITE_MAX_PAGE_SIZE=100

# Maximum notifications to show
VITE_NOTIFICATION_LIMIT=10

# --------------------------------------------
# API Timing (Optional - milliseconds)
# --------------------------------------------
# Request timeout
VITE_API_REQUEST_TIMEOUT=10000

# Retry delay between failed requests
VITE_API_RETRY_DELAY=1000

# UI Timing
# --------------------------------------------
# Debounce delay for search inputs
VITE_DEBOUNCE_DELAY=400

# --------------------------------------------
# Production Configuration
# --------------------------------------------
# Uncomment and set when deploying to production
# VITE_API_BASE_URL=https://api.your-domain.com/api/story-weaver
