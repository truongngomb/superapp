# ============================================
# StoryWeaver Frontend Configuration
# ============================================

# API Server URL
# Point to your running backend API server
VITE_API_URL=http://localhost:3001

# Development Server Port
# Port for the Vite dev server
VITE_PORT=3002

# Optional: Production API URL
# Uncomment and set when deploying to production
# VITE_API_URL=https://api.your-domain.com
