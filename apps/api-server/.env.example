# ============================================
# API Server Configuration
# ============================================

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# URLs
CLIENT_URL=http://localhost:3002
SERVER_URL=http://localhost:3001

# Database - PocketBase
POCKETBASE_URL=http://localhost:8090

# PocketBase Admin (for migrations)
# Optional - only needed for database migrations
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=your_secure_password_here

# ============================================
# AI & Media Services
# ============================================

# Google Gemini API Key
# Required for AI script generation feature
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# FFmpeg Path (Optional)
# Leave blank if ffmpeg is in system PATH
# Windows example: C:/ffmpeg/bin/ffmpeg.exe
# Linux/Mac example: /usr/local/bin/ffmpeg
FFMPEG_PATH=

# ============================================
# Application Settings
# ============================================

# Pagination
ITEMS_PER_PAGE=20

# Cache Settings (seconds)
CACHE_DEFAULT_TTL=300
CACHE_CHECK_PERIOD=120

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_BATCH_MAX=10
RATE_LIMIT_STANDARD_MAX=100

# Auth & Session
AUTH_SESSION_MAX_AGE=604800000
OAUTH_STATE_MAX_AGE=300000

# Realtime & Server
SSE_HEARTBEAT_INTERVAL=30000
REALTIME_RECONNECT_DELAY=5000
GRACEFUL_SHUTDOWN_TIMEOUT=10000

# Retry Configuration
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=500
RETRY_MAX_DELAY=5000

# CORS
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=