# ============================================
# API Server Configuration
# ============================================

# Server Configuration
PORT=3002
HOST=0.0.0.0
NODE_ENV=development

# URLs
CLIENT_URL=http://localhost:3102
SERVER_URL=http://localhost:3002
API_SERVER_URL=http://localhost:3001

# Database - PocketBase
POCKETBASE_URL=http://localhost:8090

# PocketBase Admin (for migrations)
# Optional - only needed for database migrations
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=your_secure_password_here

# CORS
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=

# ============================================
# AI & Media Services
# ============================================

# Google Gemini API Key
# Required for AI script generation feature
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Central AI Proxy Configuration (CLIProxyAPI)
# ============================================

# Base URL for AI API (OpenAI-compatible)
AI_BASE_URL=https://ai.izp.one/v1

# API Key for proxy (optional if using GEMINI_API_KEY as fallback)
AI_API_KEY=sk-dummy

# AI Models (Default)
AI_DEFAULT_TEXT_MODEL=gemini-3-flash-preview
AI_DEFAULT_IMAGE_MODEL=gemini-3-pro-image-preview

# AI Request Settings (Optional)
AI_MAX_RETRIES=3
AI_RETRY_DELAY_MS=1000
AI_REQUEST_TIMEOUT_MS=60000
AI_RATE_LIMIT_RPM=60

# FFmpeg Path (Optional)
# Leave blank if ffmpeg is in system PATH
FFMPEG_PATH=
