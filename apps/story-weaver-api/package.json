{
  "name": "@superapp/story-weaver-api",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "db": "tsx src/scripts/migrate.ts",
    "db:status": "tsx src/scripts/migrate.ts --status",
    "db:migrate": "tsx src/scripts/migrate.ts --migrate",
    "db:pull": "tsx src/scripts/migrate.ts --pull",
    "db:seed": "tsx src/scripts/migrate.ts --seed",
    "db:backup": "tsx src/scripts/migrate.ts --backup",
    "db:generate": "tsx src/scripts/migrate.ts --generate"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@google/generative-ai": "^0.24.1",
    "@scalar/express-api-reference": "^0.8.33",
    "@superapp/core-sdk": "workspace:*",
    "@superapp/shared-types": "workspace:*",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "eventsource": "^4.1.0",
    "express": "^5.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "openai": "^6.17.0",
    "pocketbase": "^0.26.6",
    "undici": "^7.19.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/eventsource": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.7",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "openapi3-ts": "^4.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  }
}
